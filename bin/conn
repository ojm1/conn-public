#!/bin/bash
# Conn -- server panel launcher. The retired fzf version keeps its old
# name, helm-fzf, because nothing points at it any more.
# Only title an interactive terminal; --list/--check output gets piped.
[ -t 1 ] && printf '\033]0;conn\007'
# No venv: what is left needs nothing from pip. PyGObject, GTK and VTE are
# system packages, and a venv sealed off from them could not see GTK at all.
# Always the stable channel: CONN_CHANNEL=dev can reach this shell from
# anything the dev copy started (a tmux server it was first to start keeps
# its environment for every pane), and would make this conn the dev one.
unset CONN_CHANNEL CONN_DEV_NOTIFY
APP="$HOME/.local/share/conn"
exec python3 "$APP/app/main.py" "$@"
